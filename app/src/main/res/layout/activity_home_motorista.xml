<?xml version="1.0" encoding="utf-8"?>
<!-- Vai em: app/src/main/res/layout/activity_home_motorista.xml
     Mesmo visual das telas de cadastro (azul-marinho, campos brancos arredondados) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:text="@string/motorista_titulo"
            android:textColor="@color/white"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:text="@string/motorista_subtitulo"
            android:textColor="@color/subtitle"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etOrigem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:fontFamily="@font/inter_regular"
                android:gravity="center_vertical"
                android:hint="@string/motorista_hint_origem"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/hint"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etDestino"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:fontFamily="@font/inter_regular"
                android:gravity="center_vertical"
                android:hint="@string/motorista_hint_destino"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/hint"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etDataHora"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:fontFamily="@font/inter_regular"
                android:gravity="center_vertical"
                android:hint="@string/motorista_hint_data_hora"
                android:imeOptions="actionNext"
                android:inputType="none"
                android:clickable="true"
                android:focusable="false"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/hint"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etVagas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:fontFamily="@font/inter_regular"
                android:gravity="center_vertical"
                android:hint="@string/motorista_hint_vagas"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/hint"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp">

            <EditText
                android:id="@+id/etPreco"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                app:fontFamily="@font/inter_regular"
                android:gravity="center_vertical"
                android:hint="@string/motorista_hint_preco"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="@color/input_text"
                android:textColorHint="@color/hint"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbMoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/white"
                android:text="@string/motorista_cb_moto"
                android:textColor="@color/white" />

            <CheckBox
                android:id="@+id/cbGratuita"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/white"
                android:text="@string/motorista_cb_gratuita"
                android:textColor="@color/white" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOferecer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            app:fontFamily="@font/inter_bold"
            android:stateListAnimator="@null"
            android:text="@string/motorista_btn_oferecer"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMinhasCaronas"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            app:fontFamily="@font/inter_bold"
            android:stateListAnimator="@null"
            android:text="@string/motorista_btn_minhas"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            app:backgroundTint="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button"
            app:fontFamily="@font/inter_bold"
            android:stateListAnimator="@null"
            android:text="@string/motorista_btn_sair"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:fontFamily="@font/inter_bold"
            android:text="@string/motorista_secao"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <!-- Fundo claro: as linhas e botões criados pelo código (TelaUi) foram feitos para fundo claro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F5F7FB"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvVazio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/motorista_vazio"
                android:textColor="@color/input_text"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>