<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/telaEscolhaPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <TextView
        android:id="@+id/tituloEscolhaPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:text="@string/perfil_pergunta"
        android:textColor="@color/white"
        android:textSize="54sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28" />

    <LinearLayout
        android:id="@+id/opcoesPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="42dp"
        android:layout_marginTop="108dp"
        android:layout_marginEnd="42dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloEscolhaPerfil">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMotorista"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_perfil_motorista"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/perfil_motorista"
            android:textAllCaps="false"
            android:textColor="@color/screen_bg"
            android:textSize="27sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPassageiro"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_perfil_passageiro"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/perfil_passageiro"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="27sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="128dp"
        android:layout_height="5dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/home_indicator"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
